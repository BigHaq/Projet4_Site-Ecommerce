# ============================================================
# MARCHÉ KORA — Variables d'environnement Backend
# Copiez ce fichier en .env et renseignez vos vraies valeurs
# NE JAMAIS committer le fichier .env dans git
# ============================================================

# ── Serveur ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# ── Base de données ───────────────────────────────────────────
# PostgreSQL (via Docker : docker-compose up -d)
DATABASE_URL="postgresql://marche_kora:kora_secret_2024@localhost:5432/marche_kora_db"

# ── JWT ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Mode paiement ─────────────────────────────────────────────
# Options : simulation | cinetpay | mtn | moov
# En développement sans clés réelles, utilisez "simulation"
PAYMENT_MODE=simulation

# ── CinetPay (agrégateur multi-opérateurs) ────────────────────
# Obtenir sur : https://cinetpay.com/dashboard/api
# Couvre MTN MoMo, Moov Money/Flooz, Wave, Orange Money
CINETPAY_API_KEY=your_cinetpay_api_key
CINETPAY_SITE_ID=your_cinetpay_site_id
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2
# En sandbox : https://api-checkout.cinetpay.com/v2 (même URL, clés sandbox suffisent)

# ── MTN Mobile Money (Direct Sandbox) ─────────────────────────
# Obtenir sur : https://momodeveloper.mtn.com/
# 1. Créer un compte développeur
# 2. S'abonner au produit "Collections"
# 3. Créer un Sandbox API user via POST /v1_0/apiuser
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=your_mtn_momo_subscription_key
MTN_MOMO_API_USER=your_mtn_momo_api_user_uuid
MTN_MOMO_API_KEY=your_mtn_momo_api_key
MTN_MOMO_ENVIRONMENT=sandbox
# En production : remplacer par mtncotedivoire, mtnbenin, etc.
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_COLLECTION_URL=https://sandbox.momodeveloper.mtn.com/collection

# ── Moov Money / Flooz ────────────────────────────────────────
# Contacter Moov directement : api@moov-africa.com
# Documentation : https://developer.moov-africa.com (si disponible)
MOOV_MONEY_BASE_URL=https://api.moov-africa.com
MOOV_MONEY_API_KEY=your_moov_money_api_key
MOOV_MONEY_SECRET=your_moov_money_secret
MOOV_MONEY_PARTNER_CODE=your_moov_partner_code

# ── URLs de callback (webhooks) ───────────────────────────────
# En dev, utiliser ngrok : ngrok http 3001
# Puis copier l'URL HTTPS générée ici
WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok.io
# L'URL de callback complète sera : ${WEBHOOK_BASE_URL}/api/payments/callback

# ── Simulation (mode développement) ──────────────────────────
# Délai simulé avant confirmation USSD (en ms)
SIMULATION_DELAY_MS=10000
# Taux de succès simulé (0.0 à 1.0)
SIMULATION_SUCCESS_RATE=0.85
